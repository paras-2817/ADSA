def dijkstra(graph, start):
    n = len(graph)

    distance = [float('inf')] * n
    visited = [False] * n

    distance[start] = 0

    for _ in range(n):
        min_distance = float('inf')
        current = -1

        for i in range(n):
            if not visited[i] and distance[i] < min_distance:
                min_distance = distance[i]
                current = i

        if current == -1:
            break

        visited[current] = True

        for i in range(n):
            if graph[current][i] != 0 and not visited[i]:
                new_distance = distance[current] + graph[current][i]

                if new_distance < distance[i]:
                    distance[i] = new_distance

    return distance


graph = [
    [0, 4, 1, 0],
    [4, 0, 2, 5],
    [1, 2, 0, 8],
    [0, 5, 8, 0]
]

result = dijkstra(graph, 0)

print("Shortest distances from vertex 0:")

for i in range(len(result)):
    print("Vertex", i, ":", result[i])
