def is_safe(v, graph, path, pos):
    # Check if the vertex is connected to the previous vertex
    if graph[path[pos - 1]][v] == 0:
        return False

    # Check if the vertex is already included in the path
    if v in path:
        return False

    return True


def hamiltonian_cycle(graph, path, pos, n):
    # If all vertices are included
    if pos == n:
        if graph[path[pos - 1]][path[0]] == 1:
            return True
        return False

    # Try different vertices
    for v in range(1, n):
        if is_safe(v, graph, path, pos):
            path[pos] = v

            if hamiltonian_cycle(graph, path, pos + 1, n):
                return True

            # Backtracking
            path[pos] = -1

    return False


n = int(input("Enter number of vertices: "))

graph = []
print("Enter adjacency matrix:")
for i in range(n):
    row = list(map(int, input().split()))
    graph.append(row)

path = [-1] * n
path[0] = 0

if hamiltonian_cycle(graph, path, 1, n):
    print("Hamiltonian Cycle exists:")
    print(*[v + 1 for v in path], path[0] + 1, sep=" -> ")
else:
    print("Hamiltonian Cycle does not exist.")
