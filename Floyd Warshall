def floyd_warshall(graph, n):
    dist = [row[:] for row in graph]

    for k in range(n):
        for i in range(n):
            for j in range(n):
                if dist[i][k] + dist[k][j] < dist[i][j]:
                    dist[i][j] = dist[i][k] + dist[k][j]

    return dist

INF = 99999

graph = [
    [0,   5,  INF, 10],
    [INF, 0,  3,   INF],
    [INF, INF, 0,   1],
    [INF, INF, INF, 0]
]

n = 4

result = floyd_warshall(graph, n)

print("Shortest distance matrix:")

for i in range(n):
    for j in range(n):
        if result[i][j] == INF:
            print("INF", end=" ")
        else:
            print(result[i][j], end=" ")
    print()
