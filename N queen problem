def is_safe(board, row, col, n):
    # Check the upper diagonal on the left
    for i in range(row):
        if board[i][col] == 1:
            return False

    # Check upper-left diagonal
    i = row - 1
    j = col - 1
    while i >= 0 and j >= 0:
        if board[i][j] == 1:
            return False
        i -= 1
        j -= 1

    # Check upper-right diagonal
    i = row - 1
    j = col + 1
    while i >= 0 and j < n:
        if board[i][j] == 1:
            return False
        i -= 1
        j += 1

    return True


def solve_n_queens(board, row, n):
    # All queens are placed
    if row == n:
        for i in range(n):
            for j in range(n):
                print("Q" if board[i][j] == 1 else ".", end=" ")
            print()
        print()
        return

    # Try placing a queen in each column
    for col in range(n):
        if is_safe(board, row, col, n):
            board[row][col] = 1

            solve_n_queens(board, row + 1, n)

            # Backtracking
            board[row][col] = 0


